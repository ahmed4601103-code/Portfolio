# Copy this file to .env and fill in your own values. Never share .env.

# AI chatbot (Google AI Studio key)
GEMINI_API_KEY=your-gemini-api-key

# Contact form (Gmail: use a 16-letter App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-gmail-app-password
CONTACT_TO=youraddress@gmail.com

# Contact form when hosted online (Render/Railway block Gmail's email ports).
# Free key from resend.com. CONTACT_TO must be the email you signed up to Resend with.
RESEND_API_KEY=re_your-resend-key

PORT=3000
